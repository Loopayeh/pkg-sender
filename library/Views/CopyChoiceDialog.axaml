<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PkgSender.Views.CopyChoiceDialog"
        Title="File exists on console" Width="440" Height="270"
        CanResize="False" ShowInTaskbar="False"
        Background="#202020" Foreground="#F1F3F8" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
  <StackPanel Spacing="8" Margin="24,20">
    <TextBlock Text="This file is already on the console (partial)." FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock Name="DetailText" FontSize="12" Foreground="#8B93A5" TextWrapping="Wrap"/>
    <TextBlock Text="Resume from where it stopped, or overwrite from zero?" FontSize="12" Margin="0,4,0,0"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Name="CancelButton" Content="Cancel" Classes="ghost" MinWidth="90"/>
      <Button Name="OverwriteButton" Content="Overwrite" Classes="ghost" MinWidth="100"/>
      <Button Name="ResumeButton" Content="Resume" MinWidth="100" FontWeight="Bold"/>
    </StackPanel>
  </StackPanel>
</Window>
