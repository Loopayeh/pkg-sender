<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PkgSender.ViewModels"
             xmlns:views="clr-namespace:PkgSender.Views"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="PkgSender.Views.LibraryView"
             Foreground="#F1F3F8" Background="#171717" FontFamily="Segoe UI">
  <UserControl.Resources>
    <views:Ps5CardBackgroundConverter x:Key="Ps5CardBg"/>
    <views:Ps5ImageBackgroundConverter x:Key="Ps5ImgBg"/>
    <views:Ps5CardPaddingConverter x:Key="Ps5CardPad"/>
    <views:SelectedBorderConverter x:Key="SelBorder"/>
  </UserControl.Resources>
  <Design.DataContext>
    <vm:LibraryViewModel/>
  </Design.DataContext>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- header -->
    <Border Grid.Row="0" Background="#202020" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Background="#4F8EF7" CornerRadius="9" Width="38" Height="38" ClipToBounds="True">
            <Image Source="/Assets/logo.png" Width="38" Height="38"/>
          </Border>
          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="PKG Sender" FontSize="18" FontWeight="Bold" Foreground="#F1F3F8"/>
            <TextBlock Text="PKG install over LAN" FontSize="11" Foreground="#8B93A5"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Background="#2A2A2A" CornerRadius="6" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="PS" VerticalAlignment="Center" Foreground="#8B93A5" FontSize="11" FontWeight="Bold"/>
              <TextBox Text="{Binding PsIp, Mode=TwoWay}" Width="120" Watermark="console IP"/>
              <Button Content="Test" Name="BtnTest" MinWidth="64" Padding="12,9"/>
              <Button Content="↻" Name="BtnRedetect" MinWidth="40" ToolTip.Tip="Look for the console again"/>
            </StackPanel>
          </Border>
          <Border Background="#2A2A2A" CornerRadius="6" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="PC" VerticalAlignment="Center" Foreground="#8B93A5" FontSize="11" FontWeight="Bold"/>
              <ComboBox Name="PcIpBox" Width="140" ToolTip.Tip="Auto-detected LAN address — pick the NIC on the console's network"/>
            </StackPanel>
          </Border>
          <Border Background="#2A2A2A" Width="1" Margin="4,6"/>
          <TextBlock Name="TestResultText" Text="{Binding TestResult}" VerticalAlignment="Center" FontSize="11" Foreground="#8B93A5" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- toolbar -->
    <Border Grid.Row="1" Background="#202020" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid RowDefinitions="Auto" RowSpacing="8">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
          <Button Grid.Column="0" Content="Scan drives…" Name="BtnAddDrive" MinWidth="120" Margin="0,0,8,0" ToolTip.Tip="Pick drive(s) to search for PKG files"/>
          <Button Grid.Column="1" Content="+ Add folder" Name="BtnAddFolder" Classes="ghost" Margin="0,0,8,0"/>
          <Button Grid.Column="2" Content="Scan" Name="BtnScan" Classes="ghost" Margin="0,0,8,0"/>
          <Border Grid.Column="3" Background="#2A2A2A" Width="1" Margin="4,4,12,4"/>
          <ComboBox Grid.Column="4" Name="PlatformBox" Width="110" Margin="0,0,8,0"/>
          <ComboBox Grid.Column="5" Name="SortBox" Width="130" Margin="0,0,8,0" ToolTip.Tip="Sort library"/>
          <Grid Grid.Column="6" Margin="0,0,8,0">
            <TextBox Text="{Binding Search, Mode=TwoWay}" Watermark="🔍 Search title, ID…" Padding="10,8,36,8"/>
            <Button Content="✕" Name="BtnClearSearch" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Padding="10,4" MinWidth="0"
                    FontSize="11" Foreground="#8B93A5" ToolTip.Tip="Back to full library"/>
          </Grid>
          <Border Grid.Column="7" Background="#2A2A2A" Width="1" Margin="8,4,16,4"/>
          <Button Grid.Column="8" Content="Send PKG" Name="BtnSend" MinWidth="150" FontWeight="Bold" Margin="0,0,8,0" ToolTip.Tip="Send selected .pkg files to the console downloader"/>
          <Button Grid.Column="9" Content="■" Name="BtnStop" MinWidth="40" Margin="0,0,8,0" ToolTip.Tip="Stop the running queue (keeps the rows)"/>
          <Button Grid.Column="10" Content="Clear done" Name="BtnClearDone" ToolTip.Tip="Remove finished rows only — never touches active downloads"/>
        </Grid>
      </Grid>
    </Border>

    <!-- body -->
    <Grid Grid.Row="2" ColumnDefinitions="*,300" Margin="16,12">
      <Border Background="#202020" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="{Binding GamesLabel}" Foreground="#8B93A5" FontSize="12" Margin="4,0,0,8"/>
          <ListBox Grid.Row="1" Name="GamesList" ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0"
                   SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Width="196" CornerRadius="2" Margin="4"
                        Background="{Binding IsPs5, Converter={StaticResource Ps5CardBg}}"
                        BorderBrush="{Binding IsSelected, Converter={StaticResource SelBorder}}"
                        BorderThickness="2"
                        Padding="10">
                  <Grid>
                    <StackPanel Spacing="6">
                      <Border CornerRadius="{Binding ImageRadius}" ClipToBounds="True" Height="176"
                              Background="{Binding IsPs5, Converter={StaticResource Ps5ImgBg}}">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#F1F3F8" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="#8B93A5" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Border Background="#F1F3F8" CornerRadius="4" Padding="8,2" IsVisible="{Binding IsPs5}">
                            <TextBlock Text="PS5" FontSize="11" FontWeight="Bold" Foreground="#171717"/>
                          </Border>
                          <Border Background="#0070D1" CornerRadius="4" Padding="8,2" IsVisible="{Binding IsPs4}">
                            <TextBlock Text="PS4" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                          </Border>
                          <Border Background="#E8A34C" CornerRadius="4" Padding="8,2" IsVisible="{Binding IsDlc}">
                            <TextBlock Text="DLC" FontSize="11" FontWeight="Bold" Foreground="#171717"/>
                          </Border>
                          <Button Name="LinkBtn" Content="{Binding FamilyCount, StringFormat='🔗×{0}'}"
                                  IsVisible="{Binding HasFamily}" ToolTip.Tip="{Binding FamilyTip}"
                                  Padding="8,2" FontSize="11" FontWeight="Bold"
                                  Background="#2A2A2A" Foreground="#4F8EF7" CornerRadius="4"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11" Foreground="#8B93A5" VerticalAlignment="Center"/>
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#202020" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="12,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="Send queue" FontWeight="Bold" FontSize="13" Foreground="#F1F3F8" VerticalAlignment="Center"/>
            <CheckBox Grid.Column="1" Content="PS4 console" IsChecked="{Binding SequentialMode, Mode=TwoWay}"
                      FontSize="11" Foreground="#8B93A5" VerticalAlignment="Center"
                      ToolTip.Tip="Tick when the target is a PS4: games install strictly one-by-one (PS5 queues natively)"/>
          </Grid>
          <ListBox Grid.Row="1" Name="QueueList" ItemsSource="{Binding Queue}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#2A2A2A" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Game.Title}" FontWeight="Bold" FontSize="12" Foreground="#F1F3F8" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding State}" FontSize="11" Foreground="#4F8EF7" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="11" Foreground="#8B93A5" VerticalAlignment="Center"/>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" CornerRadius="3" Foreground="#4F8EF7" Background="#171717"/>
                    <Button Content="Resume" IsVisible="{Binding CanResume}" HorizontalAlignment="Right" Padding="12,4" FontSize="11"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
            <TextBlock Text="{Binding QueueLabel}" FontSize="11" Foreground="#8B93A5"/>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding TotalProgress}" Height="8" CornerRadius="4" Foreground="#4F8EF7" Background="#2A2A2A"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- status -->
    <Border Grid.Row="3" Background="#202020" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid ColumnDefinitions="4,*,Auto,Auto,Auto">
        <Border Background="#4F8EF7" CornerRadius="2" Margin="0,4"/>
        <TextBlock Grid.Column="1" Text="{Binding Status}" Margin="10,0,0,0" FontSize="11" Foreground="#F1F3F8" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="Guide" Name="BtnGuide" Classes="ghost" Margin="8,0,0,0" Padding="12,4" FontSize="11" FontWeight="Normal" ToolTip.Tip="Setup manual"/>
        <Button Grid.Column="3" Content="Check updates" Name="BtnUpdate" Classes="ghost" Margin="8,0,0,0" Padding="12,4" FontSize="11" FontWeight="Normal"/>
        <Button Grid.Column="4" Content="♥ About" Name="BtnAbout" Margin="8,0,0,0" Padding="12,4" FontSize="11" FontWeight="Bold" ToolTip.Tip="About PKG Sender — support links"/>
      </Grid>
    </Border>
  </Grid>

  <UserControl.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="Foreground" Value="#F1F3F8"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#4F8EF7"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#4F8EF7"/>
      <Setter Property="Foreground" Value="#171717"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#404040"/>
      <Setter Property="Foreground" Value="#F1F3F8"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6EA3F9"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="TextBlock.Foreground" Value="#8B93A5"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
  </UserControl.Styles>
</UserControl>