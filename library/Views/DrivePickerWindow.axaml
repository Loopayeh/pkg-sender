<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PkgSender.Views.DrivePickerWindow"
        Title="Select drives to scan" Width="480" Height="440"
        Foreground="#F1F3F8" Background="#171717" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock Grid.Row="0" Text="Tick the drives to scan for games:" FontSize="13" FontWeight="Bold" Foreground="#F1F3F8" Margin="0,0,0,10"/>
    <Border Grid.Row="1" Background="#202020" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="8">
      <ListBox Name="DriveList" ItemsSource="{Binding Drives}" Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsReady}" Margin="4">
              <StackPanel Spacing="1" Margin="6,0,0,0">
                <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="#F1F3F8"/>
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8B93A5"/>
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Name="BtnCancel" MinWidth="110"/>
      <Button Content="Scan" Name="BtnOk" MinWidth="110"/>
    </StackPanel>
  </Grid>

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#4F8EF7"/>
      <Setter Property="Foreground" Value="#171717"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#6EA3F9"/>
    </Style>
  </Window.Styles>
</Window>
