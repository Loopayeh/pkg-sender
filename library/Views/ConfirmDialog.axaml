<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PkgSender.Views.ConfirmDialog"
        Width="420" Height="200"
        CanResize="False" ShowInTaskbar="False"
        Background="#202020" Foreground="#F1F3F8" FontFamily="Segoe UI, Inter"
        WindowStartupLocation="CenterOwner">
  <StackPanel Spacing="8" Margin="24,20">
    <TextBlock Name="TitleText" FontSize="14" FontWeight="Bold" TextWrapping="Wrap"/>
    <TextBlock Name="MessageText" FontSize="12" Foreground="#8B93A5" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Name="CancelButton" Content="Cancel" MinWidth="100" Classes="ghost"/>
      <Button Name="OkButton" Content="OK" MinWidth="100"/>
    </StackPanel>
  </StackPanel>
</Window>
